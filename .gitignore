# Unreal Engine .gitignore

# Builds, generated folders and local assets
Binaries/
Build/
Content/
DerivedDataCache/
Intermediate/
Saved/

# Visual Studio / VS Code / Rider
.vscode/
.idea/
.vs/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.xcworkspace
*.code-workspace

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node / TypeScript dependencies and caches
node_modules/

# Puerts generated/cache files
.v8flags.*
ts_file_versions_info.json
Plugins/Puerts/ThirdParty/
Plugins/Puerts/**/obj/

# Local archives / downloaded SDK packages
*.tgz
*.tar.gz
*.zip
*.7z
*.rar
